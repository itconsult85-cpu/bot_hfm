# Node bot runtime configuration. Never commit the real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=db_hfm_bot
API_PORT=3000
CI_BASE_URL=https://your-ci4-host.example/bot_wa
HFM_API_KEY=
# BOT_CONTROL_TOKEN is read from bot_globals and must be a long random value.
# MTProto credentials are required for the group-members scan; CI_BASE_URL alone is not sufficient.
MTPROTO_API_ID=
MTPROTO_API_HASH=
# StringSession akun Telegram khusus, dibuat dengan scripts/create-mtproto-session.js.
MTPROTO_SESSION=
# Batas maksimum anggota yang dibaca dalam satu scan.
MTPROTO_SCAN_LIMIT=100000
